# Copy to .env and fill in locally. NEVER commit .env.
# Put the key for whichever LLM you use. With none, the app runs offline (extractive answers).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SARVAM_API_KEY=

# Which LLM answers questions: anthropic | gemini | sarvam | extractive
# If the chosen provider has no key, the first provider that has one is used instead.
# QA_GENERATION__PROVIDER=sarvam

# Optional overrides of config/settings.yaml (QA_<SECTION>__<KEY>)
# QA_GENERATION__MODEL=sarvam-105b      # model ids that don't match the provider use its default
# QA_RETRIEVAL__TOP_K=5
# QA_LOG_LEVEL=DEBUG
